# ─── Web App — Environment Variables ───
# Copy this file to .env.local and fill in the values.

# Site URL used for metadata, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=https://wam.team

# Resend API key for contact-form emails (optional — degrades gracefully)
# Sign up at https://resend.com and add your API key
RESEND_API_KEY=

# Contact-form recipient email (optional, defaults to hello@wam.team)
CONTACT_EMAIL=hello@wam.team
