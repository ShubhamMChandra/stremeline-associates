# ─── Streamline Associates — Environment Variables ───
# Copy this file to .env.local and fill in the values.

# Site URL used for metadata, sitemap, and robots.txt
# Required for production; defaults to https://streamlineassociates.com
NEXT_PUBLIC_SITE_URL=https://streamlineassociates.com

# Resend API key for sending contact-form emails
# Optional — contact form degrades gracefully without it (logs to console)
RESEND_API_KEY=

# Email address that receives contact-form submissions
# Optional — defaults to hello@streamlineassociates.com
CONTACT_EMAIL=hello@streamlineassociates.com
